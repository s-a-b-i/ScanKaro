{
  "expo": {
    "name": "ScanKaro",
    "slug": "ScanKaro",
    "scheme": "scankaro",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "ScanKaro needs access to your photos to import and save document scans.",
          "cameraPermission": "ScanKaro needs camera access to scan documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScanKaro needs camera access to scan documents.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "ScanKaro needs camera access to scan documents with live edge detection."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F2F3F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0F12"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ScanKaro needs camera access to scan documents.",
        "NSPhotoLibraryUsageDescription": "ScanKaro needs access to your photos to import and save document scans."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131418",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ],
      "package": "com.bytegens.ScanKaro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
