# Copy to .env (do not commit .env)

# Firebase (from Firebase Console → Project settings → Your apps → Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In — Web client (Firebase → Authentication → Google → Web SDK configuration)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Required for Expo Go on iPhone — Google Cloud → Credentials → Create OAuth client → iOS
# Bundle ID must be: host.exp.Exponent
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Required for Expo Go on Android — package name: host.exp.exponent
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Backend / Cloudinary (wire later)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_USE_MOCK_DATA=true
