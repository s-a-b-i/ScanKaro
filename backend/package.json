{
  "name": "scankaro-api",
  "version": "1.0.0",
  "description": "ScanKaro REST API — Express, MongoDB, Firebase Admin, Cloudinary",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/ocr-worker.js",
    "worker:ocr": "node src/ocr-worker.js",
    "start": "node src/server.js",
    "redis:up": "docker compose -f ../docker-compose.yml up -d redis",
    "redis:down": "docker compose -f ../docker-compose.yml down",
    "redis:logs": "docker compose -f ../docker-compose.yml logs -f redis"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bull": "^4.16.5",
    "cloudinary": "^2.6.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "rate-limiter-flexible": "^11.2.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.19.0",
    "zod": "^3.24.2"
  },
  "private": true
}
