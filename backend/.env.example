NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/scankaro

# Firebase Admin (Firebase Console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=scankaro-3e1aa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@scankaro-3e1aa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (wire when ready)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=scankaro

# CORS — comma-separated origins in production
CORS_ORIGIN=*

# Rate limiting (Redis-backed per-user limits)
API_RATE_LIMIT_MAX=200
API_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_PAGES_RATE_LIMIT_MAX=50
UPLOAD_PAGES_RATE_LIMIT_WINDOW_MS=3600000
IP_RATE_LIMIT_MAX=500

# Request body size limits (multipart uploads use multer limits separately)
REQUEST_JSON_LIMIT=1mb
REQUEST_URLENCODED_LIMIT=1mb

# Redis response cache TTLs (seconds)
CACHE_TTL_FOLDERS_SECONDS=60
CACHE_TTL_USER_PROFILE_SECONDS=120

# Legacy IP rate limit (deprecated — use API_RATE_LIMIT_* above)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis + OCR queue (run: docker compose up -d redis from project root)
REDIS_URL=redis://127.0.0.1:6379
OCR_PROVIDER=tesseract
# OCR_PROVIDER=google
# GOOGLE_CLOUD_VISION_API_KEY=
OCR_QUEUE_CONCURRENCY=2
# Run OCR worker inside API process (dev only; use worker:ocr in production)
OCR_START_WORKER=false
